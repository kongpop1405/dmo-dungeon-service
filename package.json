{
  "name": "dmo-dungeon-service",
  "version": "1.0.0",
  "description": "DMO Dungeon Service — FB poster generator (HTML -> PNG)",
  "type": "module",
  "scripts": {
    "serve": "python -m http.server 8777",
    "export": "node build/export_poster.mjs",
    "export:dungeons": "node build/export_dungeons.mjs",
    "export:pricelist": "node build/export_pricelist.mjs",
    "export:items": "node build/export_items.mjs",
    "export:card": "node build/export_card.mjs",
    "export:ad": "node build/export_card.mjs --ad",
    "export:master2": "node build/export_card.mjs master2",
    "export:neverland-discord": "node build/export_card.mjs neverland-discord",
    "export:neverland-facebook": "node build/export_card.mjs neverland-facebook",
